# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=dpms
POSTGRES_USER=dpms_user
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://dpms_user:your_secure_password_here@localhost:5435/dpms
REDIS_URL=redis://localhost:6385/0

# ------------------------------------------------------------------------------
# 2. Flask Backend Configuration
# ------------------------------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=your_very_long_random_secret_key_here
FRONTEND_URL=http://localhost:5173

# Firebase Service Account JSON — place the file inside backend/ and set filename here
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# HOD Emails — comma-separated, every listed email gets HOD role on first login
HOD_EMAILS=hod@yourcollege.edu,secondhod@yourcollege.edu

# ------------------------------------------------------------------------------
# 3. React Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key
VITE_API_BASE_URL=http://localhost:5055

# ------------------------------------------------------------------------------
# 4. SMTP Email Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_username@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_SENDER=HIVE Board <your_gmail_username@gmail.com>
SMTP_USE_TLS=True

# ------------------------------------------------------------------------------
# 5. AI API Keys — for AI-Powered Notes Ingestion
# ------------------------------------------------------------------------------
# Gemini (Google AI Studio) — primary AI provider (gemini-2.0-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — fallback AI provider (llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here
